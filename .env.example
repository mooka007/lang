NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
NEXT_PUBLIC_API_URL=http://localhost:5000/api
UPLOAD_MAX_MB=100
STORAGE_PROVIDER=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5544/lang_rag?schema=public
JWT_SECRET=change-this-local-secret
JWT_EXPIRES_IN_SECONDS=604800

# Model providers: openai or github
# Embedding providers: local, openai, or github
LLM_PROVIDER=github
EMBEDDING_PROVIDER=local

# GitHub Models
GITHUB_TOKEN=your_github_token_with_models_read_access
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
GITHUB_MODELS_API_VERSION=2026-03-10
LLM_MODEL=openai/gpt-4.1-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=900

# OpenAI fallback, used when LLM_PROVIDER=openai and EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
