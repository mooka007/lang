# Dependencies
node_modules/
*/node_modules/

# Build output and caches
.next/
*/.next/
dist/
build/
coverage/
.turbo/
.vercel/
.cache/

# Environment and local secrets
.env
.env.*
!.env.example
server/.env
server/.env.*
front/.env
front/.env.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
front/*.log
server/*.log

# Local generated data and uploads
server/data/
server/uploads/*
