scripts/
server/prisma/migrations/

# Keep generated public demo PDFs, ignore any extra local PDFs
server/pdfs/*.pdf
!server/pdfs/javascript-basics-for-rag.pdf
!server/pdfs/company-x-employee-knowledge-base.pdf
!server/pdfs/company-x-branch-*.pdf

# Generated clients
server/src/generated/
server/src/generated/prisma/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
