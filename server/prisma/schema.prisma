generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id
  email        String         @unique
  name         String
  passwordHash String         @map("password_hash")
  role         String         @default("user")
  employeeId   String?        @map("employee_id")
  employeeName String?        @map("employee_name")
  employeeSource String?      @map("employee_source")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  documents    RagDocument[]
  conversations Conversation[]
  ownedTeams    Team[]         @relation("TeamOwner")
  teamMemberships TeamMember[]

  employeeProfile CompanyEmployee?

  @@map("users")
}

model CompanyBranch {
  id                  String            @id
  code                String            @unique
  city                String
  country             String
  name                String
  overview            String?
  officeAddress       String?           @map("office_address")
  timezone            String?
  standardHours       String?           @map("standard_hours")
  employeeCount       Int               @default(0) @map("employee_count")
  director            String?
  operationsManager   String?           @map("operations_manager")
  engineeringManager  String?           @map("engineering_manager")
  customerSuccessManager String?        @map("customer_success_manager")
  regionalSalesManager String?          @map("regional_sales_manager")
  dataLead            String?           @map("data_lead")
  securityCoordinator String?           @map("security_coordinator")
  financeContact      String?           @map("finance_contact")
  mainProject         String?           @map("main_project")
  specialties         String[]          @default([])
  sourceFile          String            @map("source_file")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  employees           CompanyEmployee[]
  projects            CompanyBranchProject[]

  @@index([country])
  @@index([city])
  @@map("company_branches")
}

model CompanyBranchProject {
  id          String        @id
  branchId    String        @map("branch_id")
  branch      CompanyBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  code        String        @unique
  name        String
  manager     String?
  deputy      String?
  status      String?
  employeeCount Int?        @map("employee_count")
  budget      String?
  deadline    String?
  kpi         String?
  risk        String?

  @@index([branchId])
  @@map("company_branch_projects")
}

model CompanyEmployee {
  id             String         @id
  employeeId     String         @unique @map("employee_id")
  name           String
  email          String         @unique
  branchId       String?        @map("branch_id")
  branch         CompanyBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId         String?        @unique @map("user_id")
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  dateOfBirth    DateTime?      @map("date_of_birth")
  startDate      DateTime?      @map("start_date")
  department     String?
  post           String?
  salary         String?
  shift          String?
  manager        String?
  location       String?
  project        String?
  projects       String[]       @default([])
  projectManager String?        @map("project_manager")
  phone          String?
  employmentType String?        @map("employment_type")
  workMode       String?        @map("work_mode")
  responsibilityArea String?    @map("responsibility_area")
  branchProject  String?        @map("branch_project")
  localWorkstream String?       @map("local_workstream")
  projectStatus  String?        @map("project_status")
  projectBudget  String?        @map("project_budget")
  projectDeadline String?       @map("project_deadline")
  projectKpi     String?        @map("project_kpi")
  projectRisk    String?        @map("project_risk")
  skills         String[]       @default([])
  languages      String[]       @default([])
  systems        String[]       @default([])
  performanceBand String?       @map("performance_band")
  accessLevel    String?        @map("access_level")
  ptoBalance     String?        @map("pto_balance")
  weeklyDeliverables String[]   @default([]) @map("weekly_deliverables")
  dailyTasks     String[]       @default([]) @map("daily_tasks")
  sourceFile     String         @map("source_file")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([branchId])
  @@index([department])
  @@index([post])
  @@map("company_employees")
}

model Team {
  id          String       @id
  ownerId     String       @map("owner_id")
  owner       User         @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  members     TeamMember[]
  invites     TeamInvite[]
  documents   RagDocument[]

  @@index([ownerId])
  @@map("teams")
}

model TeamMember {
  id        String   @id
  teamId    String   @map("team_id")
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model TeamInvite {
  id          String    @id
  teamId      String    @map("team_id")
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email       String
  role        String    @default("member")
  status      String    @default("pending")
  invitedById String?   @map("invited_by_id")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([teamId, email])
  @@index([email])
  @@index([teamId])
  @@map("team_invites")
}

model RagDocument {
  id          String     @id
  ownerId     String?    @map("owner_id")
  owner       User?      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teamId      String?    @map("team_id")
  team        Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  fileName    String     @map("file_name")
  displayName String     @map("display_name")
  originalName String?    @map("original_name")
  storedPath  String?    @map("stored_path")
  sourceType  String     @map("source_type")
  accessLevel String     @default("private") @map("access_level")
  status      String     @default("indexed")
  version     Int        @default(1)
  chunkCount  Int        @default(0) @map("chunk_count")
  indexedAt   DateTime   @default(now()) @map("indexed_at")
  renamedAt   DateTime?  @map("renamed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  chunks      RagChunk[]

  @@index([ownerId])
  @@index([teamId])
  @@index([accessLevel])
  @@map("rag_documents")
}

model DocumentVersion {
  id          String   @id
  documentId  String   @map("document_id")
  version     Int
  displayName String   @map("display_name")
  chunkCount  Int      @default(0) @map("chunk_count")
  action      String   @default("indexed")
  indexedAt   DateTime @map("indexed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}

model ActivityLog {
  id         String   @id
  actorId    String?  @map("actor_id")
  actorName  String?  @map("actor_name")
  actorEmail String?  @map("actor_email")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  message    String
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

model RagChunk {
  id         String              @id
  documentId String              @map("document_id")
  document   RagDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  text       String
  metadata   Json
  embedding  Unsupported("vector")
  chunkIndex Int                 @map("chunk_index")
  page       Int?
  source     String?
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([documentId])
  @@index([chunkIndex])
  @@map("rag_chunks")
}

model Conversation {
  id        String    @id
  ownerId   String?   @map("owner_id")
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  messages  Message[]

  @@index([ownerId])
  @@map("conversations")
}

model Message {
  id             String       @id
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  sources        Json?
  usage          Json?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}
