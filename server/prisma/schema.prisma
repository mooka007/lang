generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id
  email        String         @unique
  name         String
  passwordHash String         @map("password_hash")
  role         String         @default("user")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  documents    RagDocument[]
  conversations Conversation[]
  ownedTeams    Team[]         @relation("TeamOwner")
  teamMemberships TeamMember[]

  @@map("users")
}

model Team {
  id          String       @id
  ownerId     String       @map("owner_id")
  owner       User         @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  members     TeamMember[]
  invites     TeamInvite[]
  documents   RagDocument[]

  @@index([ownerId])
  @@map("teams")
}

model TeamMember {
  id        String   @id
  teamId    String   @map("team_id")
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model TeamInvite {
  id          String    @id
  teamId      String    @map("team_id")
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email       String
  role        String    @default("member")
  status      String    @default("pending")
  invitedById String?   @map("invited_by_id")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([teamId, email])
  @@index([email])
  @@index([teamId])
  @@map("team_invites")
}

model RagDocument {
  id          String     @id
  ownerId     String?    @map("owner_id")
  owner       User?      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teamId      String?    @map("team_id")
  team        Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  fileName    String     @map("file_name")
  displayName String     @map("display_name")
  originalName String?    @map("original_name")
  storedPath  String?    @map("stored_path")
  sourceType  String     @map("source_type")
  accessLevel String     @default("private") @map("access_level")
  status      String     @default("indexed")
  version     Int        @default(1)
  chunkCount  Int        @default(0) @map("chunk_count")
  indexedAt   DateTime   @default(now()) @map("indexed_at")
  renamedAt   DateTime?  @map("renamed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  chunks      RagChunk[]

  @@index([ownerId])
  @@index([teamId])
  @@index([accessLevel])
  @@map("rag_documents")
}

model RagChunk {
  id         String              @id
  documentId String              @map("document_id")
  document   RagDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  text       String
  metadata   Json
  embedding  Unsupported("vector")
  chunkIndex Int                 @map("chunk_index")
  page       Int?
  source     String?
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([documentId])
  @@index([chunkIndex])
  @@map("rag_chunks")
}

model Conversation {
  id        String    @id
  ownerId   String?   @map("owner_id")
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  messages  Message[]

  @@index([ownerId])
  @@map("conversations")
}

model Message {
  id             String       @id
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  sources        Json?
  usage          Json?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}
